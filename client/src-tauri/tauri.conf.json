{
  "productName": "AnonChat",
  "version": "0.1.0",
  "identifier": "com.anonchat.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AnonChat",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:8080 ws://localhost:8080"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
